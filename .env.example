# Copy this file to .env and fill in your own values. Never commit .env.
# .env is ignored by git — only this example is tracked.

# Required in production. In dev a clearly-marked unsafe default is used.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave DATABASE_URL unset for local SQLite dev.
# For PostgreSQL, set one of:
#   DATABASE_URL=postgres://clientflow:password@localhost:5432/clientflow
#   or the POSTGRES_* variables below.
# DATABASE_URL=
# POSTGRES_DB=clientflow
# POSTGRES_USER=clientflow
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
